# Copy this file to .env and fill in your own keys.
# Never commit .env.

# Model access through OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Web and news search (https://tavily.com)
TAVILY_API_KEY=

# Tracing (https://smith.langchain.com) - optional
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=market-research-assistant

# --- Only for a deployed copy. Leave both empty on your own computer. ---

# Visitors must enter this password before the app opens.
APP_PASSWORD=

# Folder for the memory file and saved reports, when they must survive a
# restart (in the cloud: the folder where the storage bucket is mounted).
DATA_DIR=
