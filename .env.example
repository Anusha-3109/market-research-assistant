# Copy this file to .env and fill in your own keys.
# Never commit .env.

# Model access through OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Web and news search (https://tavily.com)
TAVILY_API_KEY=

# Tracing (https://smith.langchain.com) - optional
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=market-research-assistant

# --- Only for a deployed copy. Leave both empty on your own computer. ---

# Turns accounts on: visitors must sign in before the app opens, and this
# value is the invite code needed to create an account.
APP_PASSWORD=

# Email, for the "Forgot password?" link. Leave empty to switch it off.
# SMTP_USER is the address email is sent from; SMTP_PASSWORD is an app
# password of that mail account (for Gmail: Google Account > Security >
# 2-Step Verification > App passwords); APP_URL is the public address of
# the app, used in the link.
SMTP_USER=
SMTP_PASSWORD=
APP_URL=

# Folder for the memory file and saved reports, when they must survive a
# restart (in the cloud: the folder where the storage bucket is mounted).
DATA_DIR=
